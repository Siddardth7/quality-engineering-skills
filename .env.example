# Slack agent comms — copy to .env AND export into your shell before launching an agent.
# .env is gitignored; never commit real tokens.
#
#   cp .env.example .env      # then fill in real values
#   set -a; source .env; set +a   # export into the current shell (zsh/bash)
#
# Claude Code / Antigravity expand ${SLACK_BOT_TOKEN} / ${SLACK_TEAM_ID} in .mcp.json
# from the PROCESS environment — they do NOT auto-load .env. The `source` line above
# (or putting these exports in ~/.zshrc) is what makes them visible.

# Claude Code persona on THIS machine (MacBook=Michael, laptops=Jim/Dwight).
# SLACK_IDENTITY is how the agent knows who it is at session start — set it to your persona.
SLACK_IDENTITY=Michael          # one of: Michael | Jim | Dwight
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_TEAM_ID=T0BS2ESV32S

# Antigravity persona on THIS machine, if any (MacBook=Creed, laptop=Kevin).
# Distinct name so a co-located Claude + Antigravity don't collide. Point
# Antigravity's Slack config at this var. Leave unset on machines with no Antigravity.
# SLACK_BOT_TOKEN_AGY=xoxb-antigravity-persona-token

# Codex persona on THIS machine, if any (MacBook=Darryl). Third distinct var so a
# co-located Claude + Antigravity + Codex don't post as the same member. Point
# Codex's own Slack config (.codex/config.toml) at this var.
# SLACK_BOT_TOKEN_CDX=xoxb-codex-persona-token
