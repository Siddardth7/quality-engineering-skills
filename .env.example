# Slack agent comms — copy to .env AND export into your shell before launching an agent.
# .env is gitignored; never commit real tokens.
#
#   cp .env.example .env      # then fill in real values
#   set -a; source .env; set +a   # export into the current shell (zsh/bash)
#
# Claude Code / Antigravity expand ${SLACK_BOT_TOKEN} / ${SLACK_TEAM_ID} in .mcp.json
# from the PROCESS environment — they do NOT auto-load .env. The `source` line above
# (or putting these exports in ~/.zshrc) is what makes them visible.

# Claude Code persona on THIS machine (MacBook=Michael, laptops=Jim/Dwight).
# SLACK_IDENTITY is how the agent knows who it is at session start — set it to your persona.
SLACK_IDENTITY=Michael          # one of: Michael | Jim | Dwight
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_TEAM_ID=T0BS2ESV32S

# Antigravity persona on THIS machine, if any (MacBook=Creed, laptop=Kevin).
# Distinct name so a co-located Claude + Antigravity don't collide. Point
# Antigravity's Slack config at this var. Leave unset on machines with no Antigravity.
# SLACK_BOT_TOKEN_AGY=xoxb-antigravity-persona-token

# Codex persona on THIS machine, if any (MacBook=Darryl). Third distinct var so a
# co-located Claude + Antigravity + Codex don't post as the same member. Point
# Codex's own Slack config (.codex/config.toml) at this var.
# SLACK_BOT_TOKEN_CDX=xoxb-codex-persona-token

# Citation-gate manual paths — see CLAUDE.md "Standards fidelity" for what each covers.
# Copy these lines into .env (gitignored, never committed) and point each var at your own
# on-machine copy of the licensed manual. pytest loads .env automatically via the root
# conftest.py — no `set -a; source .env; set +a` needed. A real exported shell variable
# always wins over the value here.
#
# Any var left unset or pointing at the wrong file causes its domain's citation tests to
# FAIL (not silently skip) unless ALLOW_UNVERIFIED_CITATIONS=1 is also set. The licensed
# manuals are on-machine only and are never committed to git.

# MSA — AIAG MSA Reference Manual, 4th Edition (.md)
MSA_MANUAL_PATH=
# FMEA + Control Plan — AIAG-VDA FMEA Handbook, 1st Edition 2019 (.md)
FMEA_MANUAL_PATH=
# PPAP — AIAG Production Part Approval Process, 4th Edition 2006 (.md)
PPAP_MANUAL_PATH=
# RCA — Kaoru Ishikawa, Guide to Quality Control, 2nd Rev. Ed. (.md)
ISHIKAWA_MANUAL_PATH=
# RCA — Nancy R. Tague, The Quality Toolbox, 2nd Ed., ASQ (.md)
ASQ_MANUAL_PATH=
# RCA + SQE — AIAG CQI-20 Effective Problem Solving, 2nd Ed. 2018 (.md)
CQI20_MANUAL_PATH=
# RCA — Kepner & Tregoe, The New Rational Manager, Updated Ed. (.md)
KT_MANUAL_PATH=
# RCA + SQE — Ford Global 8D Manual (.md)
FORD_8D_MANUAL_PATH=
# NCR — ISO 9001:2015 §8.7, extracted section (.md)
ISO_9001_MANUAL_PATH=
# NCR — IATF 16949:2016 §8.7, extracted section (.md)
IATF_16949_MANUAL_PATH=
# COPQ — ASQ Certified Six Sigma Green Belt Handbook
COPQ_ASQ_CSSGB_MANUAL_PATH=
# COPQ — CSSC Lean Six Sigma Green Belt Certification Training Manual (2018)
COPQ_CSSC_MANUAL_PATH=
# COPQ — Lumafield Cost of Quality Report (non-standard industry benchmark)
COPQ_LUMAFIELD_MANUAL_PATH=
#
# COPQ's three sources are PDF-only on this project's boxes. A PDF read as text is binary
# noise, so COPQ's rows are verified structurally and reported as "structurally unverifiable
# (PDF-only)" — distinct from "missing config". Pointing a COPQ var at an extracted .md
# enables line-verification for that source.
#
# Local-only opt-out — set to the literal string "1" to make a missing manual skip instead
# of fail. Anything else (including "true"/"yes"/"0"/empty) is strict. Never set this by
# hand in CI; .github/workflows/ci.yml sets it for you, because CI mounts no manuals.
ALLOW_UNVERIFIED_CITATIONS=
